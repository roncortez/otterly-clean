# Aplicación web - Otterly Clean

# Base de la API. En desarrollo se deja vacío/por defecto: Vite hace de proxy
# de /api hacia el backend (ver vite.config.js) y así no hay CORS.
VITE_API_BASE_URL=/api

# Backend al que apunta el proxy de desarrollo.
VITE_API_URL=http://localhost:10000

# --- Mapa y direcciones ------------------------------------------------------
# Selección de la ubicación exacta al crear una dirección. El mapa lo dibuja
# MapLibre GL JS y los datos (teselas, búsqueda y geocodificación inversa) los
# pone Geoapify con esta única clave.
#
# La usa el navegador, así que NO es un secreto: viaja en cada petición. Lo que
# la protege son sus restricciones, y hay que configurarlas en el panel de
# Geoapify antes de publicar:
#   * Allowed origins/referrers: solo los dominios de la aplicación.
#   * Una clave por entorno (desarrollo y producción separadas).
# Sin clave, la pantalla de direcciones sigue funcionando: se escribe a mano.
VITE_GEOAPIFY_API_KEY=

# Estilo cartográfico (opcional). Por defecto osm-bright-smooth. Otros:
# osm-bright, osm-liberty, positron, dark-matter…
VITE_GEOAPIFY_MAP_STYLE=
