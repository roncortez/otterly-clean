# Aplicación web - Otterly Clean

# Base de la API. En desarrollo se deja vacío/por defecto: Vite hace de proxy
# de /api hacia el backend (ver vite.config.js) y así no hay CORS.
VITE_API_BASE_URL=/api

# Backend al que apunta el proxy de desarrollo.
VITE_API_URL=http://localhost:10000

# --- Google Maps -------------------------------------------------------------
# Selección de la ubicación exacta al crear una dirección.
#
# Esta clave la usa el navegador, así que NO es un secreto: viaja en cada
# petición al mapa. Lo que la protege son sus restricciones, y hay que
# configurarlas en la consola de Google antes de publicar:
#   * Restricción de aplicación: referrers HTTP con los dominios de la app.
#   * Restricción de API: Maps JavaScript API, Places API (New) y Geocoding API.
# Sin clave, la pantalla de direcciones sigue funcionando: se escribe a mano.
VITE_GOOGLE_MAPS_API_KEY=

# Identificador del mapa (necesario para los marcadores modernos). Crear uno
# propio en la consola permite darle el estilo de la marca.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
