# =============================================================================
# API - Otterly Clean
# Copiar a .env y ajustar. Nunca comitear el .env real.
# =============================================================================

NODE_ENV=development
PORT=10000

# --- Base de datos -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otterly_clean
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

# --- Autenticación -----------------------------------------------------------
# Obligatorio en producción. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Invitaciones ------------------------------------------------------------
# Dirección pública de la aplicación web. Con ella se construye el enlace de
# activación que recibe un trabajador invitado:
#   https://otterlyclean.ec/activar-cuenta?token=...
APP_URL=http://localhost:5173
# Horas que vive el enlace. Corta a propósito: es una credencial de un solo uso
# que abre una cuenta sin contraseña.
INVITATION_TTL_HOURS=72

# --- Cifrado de datos sensibles ----------------------------------------------
# Protege códigos de puerta, claves de alarma y ubicación de llaves.
# Debe ser 32 bytes en hex (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotar esta clave invalida los secretos ya guardados: ver docs/SECURITY.md
ENCRYPTION_KEY=change-me

# --- Región ------------------------------------------------------------------
# Región por defecto para usuarios y pedidos nuevos: EC | US
DEFAULT_REGION=EC

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Imagenes (Cloudinary) ---------------------------------------------------
# Solo para imagenes PUBLICAS: logo, icono, imagenes de servicio y banner.
# Si se dejan vacias, la pantalla de configuracion vuelve al campo de URL y
# todo lo demas sigue funcionando igual.
# Credenciales en https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raiz bajo la que se agrupa todo lo que sube la aplicacion.
CLOUDINARY_FOLDER=otterly-clean
# Tamano maximo por imagen, en bytes (5 MB por defecto).
UPLOAD_MAX_BYTES=5242880

# --- Notificaciones ----------------------------------------------------------
# console: escribe en la consola y en la tabla notifications (desarrollo).
# none: solo persiste en base de datos.
# Los proveedores reales (email/SMS/push) se añaden como drivers adicionales.
NOTIFICATIONS_DRIVER=console
